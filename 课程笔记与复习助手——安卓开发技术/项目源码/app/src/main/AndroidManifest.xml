<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络访问：用于调用新闻 API 等在线功能 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 录音权限：用于笔记中的语音记录功能 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 复习提醒：使用闹钟 + 通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" tools:targetApi="33" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CourseReviewPlanner"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".ui.auth.AuthActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CourseReviewPlanner">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".StudyPlanActivity"
            android:exported="false"
            android:label="学习计划管理"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".StudyPlanDetailActivity"
            android:exported="false"
            android:label="学习计划详情"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".StudyLoadAnalysisActivity"
            android:exported="false"
            android:label="学习压力分析"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".NoteManagementActivity"
            android:exported="false"
            android:label="笔记管理"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".NoteDetailActivity"
            android:exported="false"
            android:label="笔记详情"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".ReviewReminderActivity"
            android:exported="false"
            android:label="复习提醒"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".ReviewReminderDetailActivity"
            android:exported="false"
            android:label="复习提醒详情"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <activity
            android:name=".ReviewReminderAlertActivity"
            android:exported="false"
            android:label="复习提醒"
            android:theme="@style/Theme.CourseReviewPlanner" />
        <receiver
            android:name=".util.ReviewReminderAlarmReceiver"
            android:exported="false" />
    </application>

</manifest>